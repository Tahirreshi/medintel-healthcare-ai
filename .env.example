# ==============================================================================
# MedIntel AI Platform - Environment Configuration Template
# Instructions: Copy this file to '.env' and fill in your actual key values.
# DO NOT commit '.env' containing real secrets to GitHub or public repositories.
# ==============================================================================

# Google Gemini API Key (Optional: Required for generative clinical RAG explanations)
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (Default: medintel_healthcare.db)
MEDINTEL_DB_PATH=medintel_healthcare.db

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_SECRET_KEY=your_random_flask_secret_key_here
